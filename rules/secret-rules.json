{
  "version": 1,
  "rules": [
    {
      "id": "aws-access-key-id",
      "description": "AWS access key ID (AKIA = long-term, ASIA = temporary)",
      "severity": "high",
      "regex": "(?<![A-Z0-9])(?:AKIA|ASIA)[A-Z0-9]{16}(?![A-Z0-9])"
    },
    {
      "id": "google-api-key",
      "description": "Google API key (AIza prefix + 35 chars)",
      "severity": "high",
      "regex": "(?<![0-9A-Za-z_-])AIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])"
    },
    {
      "id": "github-token",
      "description": "GitHub token (ghp_, gho_, ghu_, ghs_, ghr_ prefix)",
      "severity": "high",
      "regex": "(?<![A-Za-z0-9_])gh[pousr]_[A-Za-z0-9]{36,}"
    },
    {
      "id": "stripe-live-secret-key",
      "description": "Stripe live secret key (sk_live_ prefix)",
      "severity": "high",
      "regex": "(?<![A-Za-z0-9_])sk_live_[0-9a-zA-Z]{24,}"
    },
    {
      "id": "private-key-block",
      "description": "Private key header (PEM / OpenSSH / PGP)",
      "severity": "high",
      "regex": "-----BEGIN (?:(?:RSA|EC|DSA|OPENSSH|ENCRYPTED) PRIVATE KEY|PRIVATE KEY|PGP PRIVATE KEY BLOCK)-----"
    },
    {
      "id": "generic-hardcoded-secret",
      "description": "Variable/field named key, secret, token or password assigned a long quoted literal",
      "severity": "medium",
      "regex": "(?i)(?:api[_-]?key|secret|token|passwd|password)[\\w.-]*[\"']?\\s*[:=]\\s*[\"']([A-Za-z0-9_\\-+/=.]{16,})[\"']",
      "secret_group": 1,
      "min_entropy": 3.0,
      "ignore_placeholders": true
    }
  ]
}
